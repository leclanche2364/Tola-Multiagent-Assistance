{
  "id": "eval-t10-8",
  "test": "T10.8 Skill baseline — shift-aware rules improve scheduling quality",
  "description": "Shift-aware planner produces higher-quality schedules than naive placement by avoiding recovery windows while still generating valid proposals",
  "input": {
    "taskTitle": "Quality comparison task",
    "taskDurationMinutes": 120,
    "isHighCognitive": true,
    "deadline": "2025-01-05T00:00:00.000Z",
    "days": [
      {
        "date": "2025-01-02",
        "dayType": "work-day",
        "availableWindows": [
          { "startsAt": "2025-01-02T09:00:00.000Z", "endsAt": "2025-01-02T12:00:00.000Z" },
          { "startsAt": "2025-01-02T13:00:00.000Z", "endsAt": "2025-01-02T17:00:00.000Z" }
        ]
      }
    ],
    "shiftSchedule": {
      "shiftStartsAt": "2025-01-02T06:00:00.000Z",
      "shiftEndsAt": "2025-01-02T14:00:00.000Z",
      "recoveryWindow": { "startsAt": "2025-01-02T07:00:00.000Z", "endsAt": "2025-01-02T09:00:00.000Z" }
    },
    "explicitOverrideRecovery": false
  },
  "expected": {
    "shiftAware": {
      "proposalsCount": ">0",
      "recoveryWindowOverlap": 0,
      "qualityMetric": "avoids-recovery",
      "allReasoningIncludesRecovery": true
    },
    "naive": {
      "proposalsCount": ">0",
      "recoveryWindowOverlap": ">=1",
      "qualityMetric": "no-recovery-awareness"
    },
    "improvement": {
      "metric": "zero-recovery-overlap",
      "description": "Shift-aware planner must have zero proposals overlapping the recovery window, whereas naive placement has at least one"
    }
  }
}
