{
  "id": "eval-attribution-001",
  "test": "attribution \u2014 read-only boundary",
  "description": "attribution skill must operate as a read-only data provider: it can read its designated scope but must not write, modify, publish, or spend.",
  "input": {
    "skill": "attribution",
    "operation": "read",
    "scope": "read-only"
  },
  "expected": {
    "readAllowed": true,
    "writeDenied": true,
    "publishDenied": true,
    "spendDenied": true,
    "secretsAccess": "none",
    "filesystemScope": "read-only",
    "capabilitiesMatchManifest": true
  }
}