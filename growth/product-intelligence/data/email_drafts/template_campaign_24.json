  "htmlContent": "<!doctype html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"x-apple-disable-message-reformatting\">\n  <meta name=\"format-detection\" content=\"telephone=no,address=no,email=no,date=no,url=no\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <meta name=\"supported-color-schemes\" content=\"light\">\n\n  <title>Asking for feedback just got easier</title>\n\n  <!--[if mso]>\n  <xml>\n    <o:OfficeDocumentSettings xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n      <o:PixelsPerInch>96</o:PixelsPerInch>\n    </o:OfficeDocumentSettings>\n  </xml>\n  <![endif]-->\n\n  <style>\n    :root {\n      color-scheme: light;\n      supported-color-schemes: light;\n    }\n\n    html,\n    body {\n      margin: 0 !important;\n      padding: 0 !important;\n      width: 100% !important;\n      background: #ffffff !important;\n    }\n\n    body {\n      font-family: Arial, Helvetica, sans-serif;\n      color: #111827;\n      -webkit-text-size-adjust: 100%;\n      -ms-text-size-adjust: 100%;\n    }\n\n    table,\n    td {\n      border-collapse: collapse !important;\n      border-spacing: 0 !important;\n      mso-table-lspace: 0pt;\n      mso-table-rspace: 0pt;\n    }\n\n    img {\n      display: block;\n      border: 0;\n      outline: none;\n      text-decoration: none;\n      height: auto;\n      -ms-interpolation-mode: bicubic;\n    }\n\n    a {\n      color: #0b6fd3;\n      text-decoration: underline;\n    }\n\n    .container {\n      width: 100%;\n      max-width: 620px;\n      margin: 0 auto;\n    }\n\n    .px {\n      padding-left: 20px !important;\n      padding-right: 20px !important;\n    }\n\n    .copy {\n      font-size: 17px !important;\n      line-height: 26px !important;\n    }\n\n    .headline {\n      font-size: 30px !important;\n      line-height: 36px !important;\n    }\n\n    .subhead {\n      font-size: 22px !important;\n      line-height: 29px !important;\n    }\n\n    .cta-table {\n      width: 100% !important;\n    }\n\n    .cta {\n      display: block !important;\n      width: 100% !important;\n      box-sizing: border-box !important;\n      padding: 15px 20px !important;\n      font-size: 16px !important;\n      line-height: 22px !important;\n      text-align: center !important;\n    }\n\n    @media screen and (min-width: 641px) {\n      .px {\n        padding-left: 34px !important;\n        padding-right: 34px !important;\n      }\n\n      .copy {\n        font-size: 18px !important;\n        line-height: 28px !important;\n      }\n\n      .headline {\n        font-size: 38px !important;\n        line-height: 44px !important;\n      }\n\n      .subhead {\n        font-size: 25px !important;\n        line-height: 32px !important;\n      }\n\n      .cta-table {\n        width: auto !important;\n      }\n\n      .cta {\n        display: inline-block !important;\n        width: auto !important;\n        min-width: 280px !important;\n        padding: 15px 24px !important;\n        font-size: 17px !important;\n        line-height: 23px !important;\n      }\n    }\n  </style>\n</head>\n\n<body style=\"margin:0; padding:0; background:#ffffff;\">\n\n  <!-- Preview text -->\n  <div style=\"display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all; font-size:1px; line-height:1px; color:#ffffff;\">\n    Collect practice-related feedback without the awkward ask.\n  </div>\n\n  <div style=\"display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all; font-size:1px; line-height:1px; color:#ffffff;\">\n    &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;\n  </div>\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#ffffff\" style=\"background:#ffffff;\">\n    <tr>\n      <td align=\"center\">\n\n        <!--[if mso]>\n        <table role=\"presentation\" width=\"620\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td>\n        <![endif]-->\n\n        <table\n          role=\"presentation\"\n          width=\"100%\"\n          cellpadding=\"0\"\n          cellspacing=\"0\"\n          border=\"0\"\n          class=\"container\"\n          style=\"width:100%; max-width:620px; margin:0 auto;\"\n        >\n\n          <!-- Browser link -->\n          <tr>\n            <td\n              align=\"center\"\n              class=\"px\"\n              style=\"padding:22px 20px 14px; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#6b7280;\"\n            >\n              Trouble viewing this email?\n              <a href=\"{{ mirror }}\" style=\"color:#0b6fd3; text-decoration:underline;\">\n                View it in your browser\n              </a>.\n            </td>\n          </tr>\n\n          <!-- Header -->\n          <tr>\n            <td\n              class=\"px\"\n              style=\"padding:0 20px 22px; font-family:Arial, Helvetica, sans-serif;\"\n            >\n              <p\n                style=\"margin:0 0 18px; font-size:20px; line-height:26px; font-weight:800; color:#0b8fbd;\"\n              >\n                Revalidation Copilot\n              </p>\n\n              <p\n                style=\"margin:0 0 10px; font-size:13px; line-height:18px; font-weight:800; letter-spacing:0.8px; color:#087d68; text-transform:uppercase;\"\n              >\n                New feature\n              </p>\n\n              <h1\n                class=\"headline\"\n                style=\"margin:0; font-family:Arial, Helvetica, sans-serif; font-size:30px; line-height:36px; font-weight:800; color:#101820; letter-spacing:-0.6px;\"\n              >\n                Asking for feedback just got easier\n              </h1>\n            </td>\n          </tr>\n\n          <!-- Intro -->\n          <tr>\n            <td\n              class=\"px\"\n              style=\"padding:0 20px 26px; font-family:Arial, Helvetica, sans-serif;\"\n            >\n              <p\n                class=\"copy\"\n                style=\"margin:0 0 20px; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                Hi {{ contact.FIRSTNAME|default:\"there\" }},\n              </p>\n\n              <p\n                class=\"copy\"\n                style=\"margin:0 0 20px; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                Most nurses tell us the same thing about revalidation:\n                <strong>the work isn&rsquo;t the problem. Asking is.</strong>\n              </p>\n\n              <p\n                class=\"copy\"\n                style=\"margin:0; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                You need five pieces of practice-related feedback every three years, which can mean five separate occasions of catching someone at the end of a shift and asking them to write something about your practice.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Problem callout -->\n          <tr>\n            <td\n              class=\"px\"\n              style=\"padding:0 20px 26px; font-family:Arial, Helvetica, sans-serif;\"\n            >\n              <table\n                role=\"presentation\"\n                width=\"100%\"\n                cellpadding=\"0\"\n                cellspacing=\"0\"\n                border=\"0\"\n                bgcolor=\"#f4fbff\"\n                style=\"background:#f4fbff; border:1px solid #d9eefb; border-radius:14px;\"\n              >\n                <tr>\n                  <td style=\"padding:22px 18px;\">\n\n                    <p\n                      style=\"margin:0 0 8px; font-size:12px; line-height:16px; font-weight:800; color:#087d68; letter-spacing:0.7px; text-transform:uppercase;\"\n                    >\n                      New\n                    </p>\n\n                    <h2\n                      class=\"subhead\"\n                      style=\"margin:0 0 10px; font-family:Arial, Helvetica, sans-serif; font-size:22px; line-height:29px; font-weight:800; color:#101820;\"\n                    >\n                      Ask for feedback without the awkward ask.\n                    </h2>\n\n                    <p\n                      class=\"copy\"\n                      style=\"margin:0; font-size:17px; line-height:26px; color:#374151;\"\n                    >\n                      Open the <strong>Add Feedback</strong> page in Revalidation Copilot and tap <strong>Ask for feedback</strong>. We&rsquo;ll create a link you can send using WhatsApp, Teams, text or email.\n                    </p>\n\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- How it works -->\n          <tr>\n            <td\n              class=\"px\"\n              style=\"padding:0 20px 28px; font-family:Arial, Helvetica, sans-serif;\"\n            >\n              <p\n                class=\"copy\"\n                style=\"margin:0 0 20px; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                They open the link, write a few sentences, and the feedback comes back into your app.\n              </p>\n\n              <p\n                class=\"copy\"\n                style=\"margin:0 0 20px; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                For them, it takes about two minutes. There&rsquo;s <strong>no account to create, no app to download and no sign-up.</strong>\n              </p>\n\n              <p\n                class=\"copy\"\n                style=\"margin:0; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                You can create as many feedback links as you need and revoke any of them at any time.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Who can provide feedback -->\n          <tr>\n            <td\n              class=\"px\"\n              style=\"padding:0 20px 26px; font-family:Arial, Helvetica, sans-serif;\"\n            >\n              <table\n                role=\"presentation\"\n                width=\"100%\"\n                cellpadding=\"0\"\n                cellspacing=\"0\"\n                border=\"0\"\n                style=\"border-top:1px solid #d9e2ec; border-bottom:1px solid #d9e2ec;\"\n              >\n                <tr>\n                  <td style=\"padding:22px 0;\">\n\n                    <h2\n                      style=\"margin:0 0 12px; font-family:Arial, Helvetica, sans-serif; font-size:21px; line-height:28px; font-weight:800; color:#101820;\"\n                    >\n                      Feedback can come from more people than you might think.\n                    </h2>\n\n                    <p\n                      class=\"copy\"\n                      style=\"margin:0 0 18px; font-size:17px; line-height:26px; color:#111827;\"\n                    >\n                      It doesn&rsquo;t have to come from another nurse.\n                    </p>\n\n                    <p\n                      class=\"copy\"\n                      style=\"margin:0 0 18px; font-size:17px; line-height:26px; color:#111827;\"\n                    >\n                      It could come from your manager, a doctor or therapist you work with, a student you&rsquo;ve supervised, or from people you&rsquo;ve cared for and their families.\n                    </p>\n\n                    <p\n                      class=\"copy\"\n                      style=\"margin:0; font-size:17px; line-height:26px; color:#111827;\"\n                    >\n                      The form adapts to whoever is answering, so a patient isn&rsquo;t asked to comment on your &ldquo;practice&rdquo; &mdash; they&rsquo;re asked about their experience of the care you provided.\n                    </p>\n\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Control section -->\n          <tr>\n            <td\n              class=\"px\"\n              style=\"padding:0 20px 26px; font-family:Arial, Helvetica, sans-serif;\"\n            >\n              <h2\n                style=\"margin:0 0 12px; font-family:Arial, Helvetica, sans-serif; font-size:21px; line-height:28px; font-weight:800; color:#101820;\"\n              >\n                You stay in control.\n              </h2>\n\n              <p\n                class=\"copy\"\n                style=\"margin:0 0 20px; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                Every response arrives in a review list first. You read it and decide whether it should become part of your portfolio.\n              </p>\n\n              <p\n                class=\"copy\"\n                style=\"margin:0; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                Nothing is added automatically, and we check feedback for information that could identify a patient before it is saved to your portfolio.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Evidence callout -->\n          <tr>\n            <td\n              class=\"px\"\n              style=\"padding:0 20px 30px; font-family:Arial, Helvetica, sans-serif;\"\n            >\n              <table\n                role=\"presentation\"\n                width=\"100%\"\n                cellpadding=\"0\"\n                cellspacing=\"0\"\n                border=\"0\"\n                bgcolor=\"#f2fbf8\"\n                style=\"background:#f2fbf8; border:1px solid #cfece4; border-radius:14px;\"\n              >\n                <tr>\n                  <td style=\"padding:22px 18px;\">\n\n                    <p\n                      style=\"margin:0 0 8px; font-size:12px; line-height:16px; font-weight:800; color:#087d68; letter-spacing:0.7px; text-transform:uppercase;\"\n                    >\n                      Worth knowing\n                    </p>\n\n                    <p\n                      class=\"copy\"\n                      style=\"margin:0; font-size:17px; line-height:26px; color:#111827;\"\n                    >\n                      Feedback collected this way is written directly by the person providing it and is recorded with its submission date, giving you a clearer record of where your feedback came from if you ever need to revisit it later.\n                    </p>\n\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- CTA -->\n          <tr>\n            <td\n              class=\"px\"\n              style=\"padding:0 20px 34px; font-family:Arial, Helvetica, sans-serif;\"\n            >\n              <p\n                class=\"copy\"\n                style=\"margin:0 0 18px; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                Open Revalidation Copilot, go to <strong>Add Feedback</strong> and tap <strong>Ask for feedback</strong> to create your first link.\n              </p>\n\n              <table\n                role=\"presentation\"\n                class=\"cta-table\"\n                align=\"center\"\n                cellpadding=\"0\"\n                cellspacing=\"0\"\n                border=\"0\"\n                style=\"width:100%;\"\n              >\n                <tr>\n                  <td\n                    align=\"center\"\n                    bgcolor=\"#0b8fbd\"\n                    style=\"background:#0b8fbd; border-radius:999px; mso-padding-alt:15px 22px;\"\n                  >\n                    <a\n                      href=\"https://www.revalidationaicopilot.co.uk/download.html?utm_source=brevo&utm_medium=email&utm_campaign=Revalidation%20Copilot%20New%20Feature%202\"\n                      target=\"_blank\"\n                      class=\"cta\"\n                      style=\"display:block; width:100%; box-sizing:border-box; padding:15px 20px; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:22px; font-weight:800; color:#ffffff; text-decoration:none; background:#0b8fbd; border:1px solid #0b8fbd; border-radius:999px;\"\n                    >\n                      Open or update Revalidation Copilot\n                    </a>\n                  </td>\n                </tr>\n              </table>\n\n              <p\n                style=\"margin:28px 0 0; font-size:17px; line-height:26px; color:#111827;\"\n              >\n                Thanks,<br>\n                <strong>The Revalidation Copilot team</strong>\n              </p>\n            </td>\n          </tr>\n\n          <!-- Disclaimer + footer -->\n          <tr>\n            <td\n              class=\"px\"\n              style=\"padding:0 20px 38px; font-family:Arial, Helvetica, sans-serif;\"\n            >\n              <table\n                role=\"presentation\"\n                width=\"100%\"\n                cellpadding=\"0\"\n                cellspacing=\"0\"\n                border=\"0\"\n              >\n                <tr>\n                  <td style=\"border-top:1px solid #d9e2ec; padding-top:22px;\">\n\n                    <p\n                      style=\"margin:0 0 18px; font-size:12px; line-height:19px; color:#6b7280; font-style:italic;\"\n                    >\n                      Revalidation Copilot is an independent product and is not affiliated with, endorsed by, or approved by the Nursing and Midwifery Council.\n                    </p>\n\n                    <p\n                      style=\"margin:0 0 16px; font-size:13px; line-height:20px; color:#6b7280;\"\n                    >\n                      To make sure you do not miss Revalidation Copilot updates, you can add this sender to your contacts or move this email to your Primary tab.\n                    </p>\n\n                    <p\n                      style=\"margin:0 0 16px; font-size:13px; line-height:20px; color:#6b7280;\"\n                    >\n                      This email was sent to {{ contact.EMAIL|default:\"your email address\" }} in the context of your Revalidation Copilot account associated with <strong>Beemal Innovation Ltd</strong>.\n                    </p>\n\n                    <p\n                      style=\"margin:0 0 16px; font-size:13px; line-height:20px; color:#6b7280;\"\n                    >\n                      Questions? Email\n                      <a\n                        href=\"mailto:support@revalidationaicopilot.co.uk\"\n                        style=\"color:#0b6fd3; text-decoration:underline;\"\n                      >\n                        support@revalidationaicopilot.co.uk\n                      </a>.\n                    </p>\n\n                    <p\n                      style=\"margin:0; font-size:13px; line-height:20px; color:#6b7280;\"\n                    >\n                      <a\n                        href=\"{{ update_profile }}\"\n                        style=\"color:#0b6fd3; text-decoration:underline;\"\n                      >\n                        Update preferences\n                      </a>\n\n                      &nbsp; | &nbsp;\n\n                      <a\n                        href=\"{{ unsubscribe }}\"\n                        style=\"color:#0b6fd3; text-decoration:underline;\"\n                      >\n                        Unsubscribe\n                      </a>\n\n                      &nbsp; | &nbsp;\n\n                      <a\n                        href=\"https://www.revalidationaicopilot.co.uk/privacy.html?utm_source=brevo&utm_medium=email&utm_campaign=Revalidation%20Copilot%20New%20Feature%202\"\n                        target=\"_blank\"\n                        style=\"color:#0b6fd3; text-decoration:underline;\"\n                      >\n                        Privacy Policy\n                      </a>\n                    </p>\n\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n        </table>\n\n        <!--[if mso]>\n            </td>\n          </tr>\n        </table>\n        <![endif]-->\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
